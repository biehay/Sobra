# Copiá este archivo como .env.local y completalo con los datos de tu proyecto
# de Supabase (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Clave secreta de Supabase (Project Settings > API > service_role). Solo la usa
# el servidor para saber a qué email mandar cada aviso. Nunca la compartas ni le
# pongas NEXT_PUBLIC_ adelante.
SUPABASE_SERVICE_ROLE_KEY=

# Dirección pública de la app, para los links de los emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Emails de aviso con Resend (https://resend.com > API Keys). Si lo dejás vacío,
# los avisos se muestran en la consola en vez de enviarse.
RESEND_API_KEY=
# Remitente. Con "onboarding@resend.dev" Resend solo envía al email de tu cuenta;
# para enviar a cualquiera verificá tu dominio en Resend y usá ese.
EMAIL_REMITENTE="Sobrá <onboarding@resend.dev>"
# Quiénes reciben los avisos de admin (lotes para revisar, nuevos usuarios, pagos), separados por coma.
ADMIN_EMAILS=tu-email@gmail.com

# Titular de Sobrá: figura en los términos y condiciones (lo exige la ley).
NEXT_PUBLIC_TITULAR_NOMBRE=
NEXT_PUBLIC_TITULAR_CUIT=
NEXT_PUBLIC_TITULAR_DOMICILIO=

# Compromisos con los usuarios (se definen antes de lanzar). Ejemplos:
# "los 10 días corridos", "los 5 días hábiles", "Lunes a viernes de 9 a 18".
NEXT_PUBLIC_PLAZO_AVISO_DEFECTOS=
NEXT_PUBLIC_PLAZO_REEMBOLSO=
NEXT_PUBLIC_HORARIO_SOPORTE=

# Clave para la tarea diaria de baja automática de precios (/api/tareas/bajas-de-precio).
# Cualquier texto largo y secreto; Vercel la manda sola si la cargás en el proyecto.
CRON_SECRET=

# Email de contacto que figura en la política de privacidad y los términos.
NEXT_PUBLIC_EMAIL_CONTACTO=hola@sobra.com.ar

# WhatsApp del equipo de Sobrá, con código de país y sin "+" ni espacios.
NEXT_PUBLIC_WHATSAPP=5491100000000

# Datos para que el comprador transfiera (cobro protegido: Sobrá retiene el pago
# hasta que se completa el retiro).
NEXT_PUBLIC_DATOS_TRANSFERENCIA="Alias: SOBRA.PAGOS · Titular: Sobrá"
